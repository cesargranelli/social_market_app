rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.points is number
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.points == resource.data.points
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /points_log/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /offers/{offerId} {
      function offerUpdateValid() {
        // Comparação segura para campo opcional: OfferModel.toMap() omite
        // expiresAt quando nulo, e acesso direto a chave inexistente em rules
        // gera erro (negaria TODA atualização, inclusive markExpired).
        return request.resource.data.confirmCount == resource.data.confirmCount
          && request.resource.data.get('expiresAt', null)
            == resource.data.get('expiresAt', null)
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'active'
              && request.resource.data.status == 'expired')
          );
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.confirmCount == 0
        && request.resource.data.status == 'active';
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && offerUpdateValid();
      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        // Alinhado às telas/repos: a busca por mercados filtra por cidade,
        // então uma store sem cidade inviabilizaria searchByName.
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0;
      allow update, delete: if false;
    }
  }
}
